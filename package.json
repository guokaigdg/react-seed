{
    "name": "react-seed",
    "version": "2.0.0",
    "description": "An out-of-the-box React enterprise frontend template",
    "type": "module",
    "license": "MIT",
    "author": {
        "name": "guokaigdg"
    },
    "contributors": [
        {
            "name": "guokaigdg",
            "email": "guokaigdg@gmail.com",
            "url": "https://github.com/guokaigdg"
        }
    ],
    "keywords": [
        "React",
        "TSX",
        "Vite",
        "React Router",
        "ESLint",
        "template"
    ],
    "homepage": "./react-seed",
    "scripts": {
        "dev": "vite",
        "start": "vite",
        "build:qa": "vite build --mode qa",
        "build:prod": "vite build --mode production",
        "preview": "vite preview",
        "clean": "rm -rf node_modules",
        "deploy": "npm run build:prod && gh-pages -d build"
    },
    "engines": {
        "node": ">= 22.22.1",
        "npm": ">= 7.0.0"
    },
    "browserslist": [
        ">0.2%",
        "not dead",
        "not op_mini all"
    ],
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged",
            "commit-msg": "commitlint --config .commitlintrc.js -E HUSKY_GIT_PARAMS"
        }
    },
    "lint-staged": {
        "*.{ts,tsx,js}": [
            "eslint"
        ],
        "*.{css,less,scss}": [
            "stylelint"
        ],
        "*.{ts,tsx,js,json,html,yml,css,less,scss,md}": [
            "prettier --write"
        ]
    },
    "devDependencies": {
        "@types/node": "^22.19.0",
        "@types/react": "^19.1.6",
        "@types/react-dom": "^19.1.5",
        "@typescript-eslint/eslint-plugin": "^8.46.3",
        "@typescript-eslint/parser": "^8.46.3",
        "@vitejs/plugin-react": "^6.0.2",
        "classnames": "^2.5.1",
        "eslint": "^9.27.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.4.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "gh-pages": "^6.3.0",
        "globals": "^17.6.0",
        "husky": "^9.1.7",
        "less": "^4.3.0",
        "lint-staged": "^17.0.5",
        "postcss-less": "^6.0.0",
        "prettier": "^3.5.3",
        "stylelint": "^17.12.0",
        "stylelint-config-recess-order": "^7.7.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-less": "^4.2.1",
        "stylelint-order": "^8.1.1",
        "typescript": "^6.0.3",
        "vite": "^8.0.14",
        "vite-plugin-svgr": "^5.2.0"
    },
    "dependencies": {
        "@phosphor-icons/react": "^2.1.10",
        "axios": "^1.9.0",
        "axios-retry": "^4.5.0",
        "mobx": "^6.13.7",
        "mobx-react-lite": "^4.1.0",
        "react": "^19.2.1",
        "react-dom": "^19.2.1",
        "react-router": "^7.6.1"
    },
    "volta": {
        "node": "22.22.3",
        "npm": "9.6.6"
    }
}
